  </tr>
  <tr>
    <th>Operador Planta Disposicion:</th>
    <td>[ ] COMARSA (Anelo) &nbsp;&nbsp; [ ] INDARSA (Parque Industrial) &nbsp;&nbsp; [ ] TREATER (Anelo)</td>
  </tr>
</table>

<table style='margin-top:20pt;'>
  <tr>
    <th style='width:33%; text-align:center;'>POR EL GENERADOR</th>
    <th style='width:34%; text-align:center;'>POR EL TRANSPORTISTA</th>
    <th style='width:33%; text-align:center;'>POR LA PLANTA DISPOSITORA</th>
  </tr>
  <tr>
    <td class='firma-caja'>Firma y Sello:<br><br>Fecha: ___/___/2026</td>
    <td class='firma-caja'>Firma y Sello:<br><br>Fecha: ___/___/2026</td>
    <td class='firma-caja'>Recepcion Conforme:<br><br>Fecha: ___/___/2026</td>
  </tr>
</table>
</body></html>
